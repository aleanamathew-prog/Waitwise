# Postgres connection string. Required by every script and by the app.
#
# Local (Homebrew, Postgres.app, Docker):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/waitwise

# Hosted Postgres (Neon, Supabase, RDS, Fly). Quote it: an unquoted `&` is a
# shell operator. Their strings carry sslmode, which the driver reads on its
# own — leave DATABASE_SSL unset:
# DATABASE_URL="postgresql://user:password@host.eu-west-2.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Only for a host that requires TLS but presents a certificate the driver cannot
# verify, such as a self-signed one. This maps to rejectUnauthorized: false and
# DISABLES certificate verification, so do not set it alongside an sslmode that
# is already giving you a verified connection.
# DATABASE_SSL=true

# Notes
# - The database must already exist; the migration creates tables, not the
#   database itself. See "Setup" in README.md.
# - Special characters in the password must be percent-encoded.
# - Nothing else is needed. The NHS ODS and postcodes.io APIs used by
#   `npm run load:providers` and by the search page take no key.
